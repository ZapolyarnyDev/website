---
import SiteLayout from "@layouts/SiteLayout.astro";
import { formatDate, getLog, isoDate, logHref } from "@/lib/content";

const entries = await getLog();
---

<SiteLayout title="Журнал — @zapolyarny">
  <main>
    <h1>Журнал</h1>
    <ul>
      {
        entries.map((entry) => (
          <li>
            <time datetime={isoDate(entry.data.date)}>
              {formatDate(entry.data.date)}
            </time>
            <a href={logHref(entry)}>{entry.data.title}</a>
          </li>
        ))
      }
    </ul>
  </main>
</SiteLayout>
