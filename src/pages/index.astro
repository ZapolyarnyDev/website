---
import { getImage, Image } from "astro:assets";
import SiteLayout from "@layouts/SiteLayout.astro";
import portrait from "@assets/images/portrait.png";
import cristalixLogo from "@assets/images/c7x-logo.png";
import heroPoster from "@assets/redesign/bg/hero-loop.png";
import {
  formatDate,
  getLog,
  getProjects,
  isoDate,
  logTypeLabels,
  projectStatusLabels,
} from "@/lib/content";
import { getMergedPullRequests, mergedPullRequestsUrl } from "@/lib/github";

const poster = await getImage({
  src: heroPoster,
  format: "webp",
  width: 1600,
  quality: 72,
});

const projects = await getProjects();
const current = projects.find((p) => p.id === "cristalix");
const latest = (await getLog()).slice(0, 4);

const pullRequests = await getMergedPullRequests();
---

<SiteLayout
  description="Павел, также известный как zapolyarny: исследователь и разработчик. Minecraft-инфраструктура, JVM-бэкенд, исследования."
>
  <main>
    <section class="hero">
      <video
        class="hero__video"
        muted
        loop
        playsinline
        preload="none"
        poster={poster.src}
        aria-hidden="true"
        data-hero-video
      >
      </video>

      <div class="hero__content">
        <Image
          class="avatar"
          src={portrait}
          alt="Портрет Павла"
          width={272}
          height={272}
          loading="eager"
          fetchpriority="high"
        />
        <h1>Исследователь &amp; разработчик</h1>
        <p class="hero__lead">
          Продуктовая разработка, софт под Minecraft, исследования с ИИ, звуком
        </p>
      </div>

      {
        current && (
          <div class="current">
            <span class="current__label">Сейчас работаю в:</span>
            <a
              class="current__link"
              href="https://cristalix.gg"
              target="_blank"
              rel="noopener"
            >
              <Image
                class="current__logo"
                src={cristalixLogo}
                alt=""
                width={44}
                height={44}
              />
              {current.data.title}
              <span class="current__arrow" aria-hidden="true">
                →
              </span>
            </a>
          </div>
        )
      }
    </section>

    <section class="section works" aria-labelledby="works-title">
      <div class="wrap">
        <div class="section__head">
          <div>
            <p class="eyebrow" data-reveal>Портфолио</p>
            <h2 class="section__title" id="works-title" data-reveal>Проекты</h2>
          </div>
          <a class="button" href="/projects" data-reveal>
            Все проекты <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <ol class="rows">
          {
            projects.map((project, i) => (
              <li class="row" data-reveal style={`--i: ${i}`}>
                <a href={`/projects/${project.id}`}>
                  <span class="row__aside">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span class="row__title">{project.data.title}</span>
                  <span class="row__text">{project.data.description}</span>
                  <span class="row__meta">
                    {[
                      projectStatusLabels[project.data.status],
                      ...project.data.stack.slice(0, 4),
                    ].join(" · ")}
                  </span>
                  <span class="row__arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="log-title">
      <div class="wrap">
        <div class="section__head">
          <div>
            <p class="eyebrow" data-reveal>Журнал</p>
            <h2 class="section__title" id="log-title" data-reveal>
              Последние записи
            </h2>
          </div>
          <a class="button" href="/log" data-reveal>
            Весь журнал <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <ol class="rows">
          {
            latest.map((entry, i) => (
              <li class="row" data-reveal style={`--i: ${i}`}>
                <a href={`/log/${entry.id}`}>
                  <time class="row__aside" datetime={isoDate(entry.data.date)}>
                    {formatDate(entry.data.date)}
                  </time>
                  <span class="row__title">{entry.data.title}</span>
                  <span class="row__text">{entry.data.description}</span>
                  <span class="row__meta">
                    {logTypeLabels[entry.data.type]}
                  </span>
                  <span class="row__arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {
      pullRequests.length > 0 && (
        <section class="section" aria-labelledby="oss-title">
          <div class="wrap">
            <div class="section__head">
              <div>
                <p class="eyebrow" data-reveal>
                  Open source
                </p>
                <h2 class="section__title" id="oss-title" data-reveal>
                  Принятые PR
                </h2>
              </div>
              <a
                class="button"
                href={mergedPullRequestsUrl}
                target="_blank"
                rel="noopener"
                data-reveal
              >
                Все на GitHub{" "}
                <span class="arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </div>
            <ol class="rows">
              {pullRequests.map((pr, i) => (
                <li class="row" data-reveal style={`--i: ${i}`}>
                  <a href={pr.url} target="_blank" rel="noopener">
                    <time class="row__aside" datetime={isoDate(pr.mergedAt)}>
                      {formatDate(pr.mergedAt)}
                    </time>
                    <span class="row__title">{pr.title}</span>
                    <span class="row__meta">
                      {pr.repo} #{pr.number}
                    </span>
                    <span class="row__arrow" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }
  </main>

  <script>
    const hero = document.querySelector<HTMLElement>(".hero");
    const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
    const calm = matchMedia("(prefers-reduced-motion: reduce)");
    const connection = (
      navigator as Navigator & {
        connection?: { saveData?: boolean; effectiveType?: string };
      }
    ).connection;
    const posterOnly =
      connection?.saveData === true ||
      /(^|-)2g$/.test(connection?.effectiveType ?? "") ||
      matchMedia("(prefers-reduced-data: reduce)").matches;
    let inView = true;

    const attach = () => {
      if (!video || video.childElementCount) return;
      const small = matchMedia("(max-width: 900px)").matches;
      const name = small ? "hero-720" : "hero";
      const formats = [
        ["webm", 'video/webm; codecs="vp9"'],
        ["mp4", "video/mp4"],
      ] as const;
      for (const [ext, type] of formats) {
        const source = document.createElement("source");
        source.src = `/media/${name}.${ext}`;
        source.type = type;
        video.append(source);
      }
      video.load();
    };

    const sync = () => {
      if (!video || posterOnly) return;
      if (calm.matches || !inView || document.hidden) {
        video.pause();
        return;
      }
      attach();
      void video.play().catch(() => undefined);
    };

    if (hero) {
      new IntersectionObserver(([entry]) => {
        inView = entry?.isIntersecting ?? true;
        sync();
      }).observe(hero);
    }
    calm.addEventListener("change", sync);
    document.addEventListener("visibilitychange", sync);
    sync();

    let ticking = false;
    const parallax = () => {
      ticking = false;
      if (!video || !inView) return;
      const y = calm.matches ? 0 : Math.min(scrollY, innerHeight * 1.2) * 0.55;
      video.style.transform = `translate3d(0, ${y}px, 0)`;
    };
    addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(parallax);
        }
      },
      { passive: true },
    );
    parallax();
  </script>

  <style is:global>
    .hero {
      position: relative;
      height: clamp(400px, 88vh, 1060px);
      height: clamp(400px, 88svh, 1060px);
      overflow: hidden;
    }

    .hero + .section {
      padding-top: clamp(32px, 4vw, 56px);
    }

    @media (max-width: 720px) {
      .hero {
        height: clamp(490px, 86vh, 820px);
        height: clamp(490px, 86svh, 820px);
      }
    }

    @media (orientation: landscape) and (max-height: 500px) {
      .hero {
        height: 100vh;
        height: 100svh;
        min-height: 300px;
      }
    }

    .hero__video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 50%;
      pointer-events: none;
      will-change: transform;
    }

    @media (max-width: 720px) {
      .hero .hero__content {
        padding-bottom: 22%;
      }

      .hero .current {
        left: 0;
        right: 0;
        align-items: center;
      }
    }

    .hero__content {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 24px;
      height: 100%;
      padding: 80px var(--gutter) 10%;
      text-align: center;
    }

    .hero__content > * {
      opacity: 0;
      transform: translateY(8px);
      animation: rise 0.5s var(--ease) forwards;
    }

    .hero__content > :nth-child(2) {
      animation-delay: 0.06s;
    }

    .hero__content > :nth-child(3) {
      animation-delay: 0.12s;
    }

    .hero__lead {
      max-width: 34ch;
      margin-top: -6px;
      color: rgb(11 18 32 / 0.74);
      font-size: clamp(17px, 1.6vw, 21px);
      line-height: 1.45;
      text-wrap: balance;
    }

    @media (prefers-reduced-motion: reduce) {
      .hero__content > * {
        opacity: 1;
        transform: none;
        filter: none;
        animation: none;
      }
    }

    .avatar {
      width: clamp(104px, 10vw, 136px);
      height: auto;
      aspect-ratio: 1;
      object-fit: cover;
      border: 1px solid rgb(11 18 32 / 0.12);
      border-radius: 50%;
      box-shadow: 0 18px 48px -20px rgb(47 91 255 / 0.55);
    }

    .hero h1 {
      max-width: 14ch;
      font-size: clamp(40px, 7.4vw, 104px);
      font-size: clamp(36px, min(7.4vw, 11svh), 104px);
      font-weight: 500;
      line-height: 1.02;
      letter-spacing: -0.035em;
      text-wrap: balance;
    }

    .current {
      position: absolute;
      left: max(var(--gutter), env(safe-area-inset-left));
      bottom: clamp(28px, 6vh, 56px);
      bottom: clamp(28px, 6svh, 56px);
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      opacity: 0;
      animation: rise 0.5s var(--ease) 0.18s forwards;
    }

    @media (prefers-reduced-motion: reduce) {
      .current {
        opacity: 1;
        animation: none;
      }
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: 0;
      -webkit-backdrop-filter: blur(9px);
      backdrop-filter: blur(9px);
      background: rgb(253 255 251 / 0.2);
      pointer-events: none;
    }

    @media (hover: none) and (pointer: coarse) {
      .hero::after {
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
        background: rgb(253 255 251 / 0.2);
      }

      .hero__video {
        inset: -24px;
        width: calc(100% + 48px);
        height: calc(100% + 48px);
        filter: blur(9px);
      }
    }

    @media (max-height: 560px) {
      .hero__content {
        gap: 12px;
        padding-top: 64px;
        padding-bottom: 6%;
      }

      .avatar {
        width: 64px;
      }

      .hero__lead {
        font-size: 15px;
      }

      .current {
        bottom: 16px;
      }

      .current__label {
        display: none;
      }
    }
  </style>
</SiteLayout>
