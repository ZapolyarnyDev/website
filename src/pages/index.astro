---
import SiteLayout from "@layouts/SiteLayout.astro";
import { getLog, getProjects, logHref, projectHref } from "@/lib/content";

const projects = await getProjects();
const latest = (await getLog()).slice(0, 4);
---

<SiteLayout>
  <main>
    <h1>Исследователь &amp; разработчик</h1>
    <h2>Проекты</h2>
    <ul>
      {
        projects.map((project) => (
          <li>
            <a href={projectHref(project)}>{project.data.title}</a>
          </li>
        ))
      }
    </ul>
    <h2>Журнал</h2>
    <ul>
      {
        latest.map((entry) => (
          <li>
            <a href={logHref(entry)}>{entry.data.title}</a>
          </li>
        ))
      }
    </ul>
  </main>
</SiteLayout>
