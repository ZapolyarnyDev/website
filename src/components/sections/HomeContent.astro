---
import { ArrowUpRight } from "lucide-astro";

import HomeWorkCard from "@components/home/HomeWorkCard.astro";
import Button from "@components/ui/Button.astro";
import Typography from "@components/ui/Typography.astro";
import { getProjects, projectHref, projectStatusLabels } from "@/lib/content";

const projects = await getProjects();
---

<div class="home-content">
  <section class="container home-section" aria-labelledby="featured-projects">
    <header class="home-section__header">
      <div>
        <Typography variant="kicker" as="span">избранное</Typography>
        <Typography variant="hero" as="h2" id="featured-projects">
          Проекты
        </Typography>
      </div>

      <Button href="/projects">
        Все проекты <ArrowUpRight class="button__icon" aria-hidden="true" />
      </Button>
    </header>

    <div class="home-works-grid">
      {
        projects.map((project) => (
          <HomeWorkCard
            href={projectHref(project)}
            label={projectStatusLabels[project.data.status]}
            title={project.data.title}
            description={project.data.description}
            tags={project.data.stack.slice(0, 3)}
          />
        ))
      }
    </div>
  </section>
</div>
